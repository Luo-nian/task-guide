{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskGuide",
  "version": "1.0.0",
  "identifier": "com.taskguide.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "任务指南",
        "width": 340,
        "height": 560,
        "minWidth": 260,
        "minHeight": 400,
        "x": 50,
        "y": 80,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/icon.png"
    ]
  }
}
