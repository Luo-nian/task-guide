{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "任务栏",
  "version": "1.0.0",
  "identifier": "com.taskbar.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "任务栏",
        "width": 1100,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480,
        "x": 100,
        "y": 80,
        "transparent": true,
        "backgroundColor": "#F7F1E3",
        "decorations": false,
        "alwaysOnTop": false,
        "resizable": true,
        "shadow": false
      },
      {
        "label": "widget",
        "title": "任务挂件",
        "url": "widget.html?v=26",
        "width": 360,
        "height": 360,
        "minWidth": 240,
        "minHeight": 180,
        "maxWidth": 760,
        "maxHeight": 1000,
        "x": 40,
        "y": 120,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}