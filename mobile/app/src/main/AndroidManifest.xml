<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络与局域网服务器 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- 通知（Android 13+ 需运行时申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 提醒相关 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- v5.15：省电优化引导（忽略电池优化需此权限） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- v5.22.5：NotificationHelper 里调了 setFullScreenIntent（"强提醒"档想锁屏全屏弹出），
         但清单从未声明该权限 → 系统静默降级成普通通知。体验测试多份报告命中。 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 前台服务（Ktor 同步服务器常驻） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".TaskBarApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TaskBar"
        tools:targetApi="34">

        <!-- 主入口 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TaskBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 前台服务：Ktor 同步服务器（手机当服务器） -->
        <service
            android:name=".server.SyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 通知 Action 接收器（完成/延迟按钮） -->
        <receiver
            android:name=".notify.ReminderActionReceiver"
            android:exported="false" />

        <!-- v5.15.3：起床/睡前每日提醒 -->
        <receiver
            android:name=".notify.DailyReminderReceiver"
            android:exported="false" />

        <!-- v5.18.5：任务提醒（系统精确闹钟）——
             实测 WorkManager 排的提醒到点 15 小时都没执行，必须走 AlarmManager -->
        <receiver
            android:name=".notify.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- 开机自启：恢复提醒调度 + 启动同步服务 -->
        <receiver
            android:name=".notify.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 桌面小部件：追踪任务卡片 -->
        <receiver
            android:name=".widget.TrackWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.taskbar.app.WIDGET_REFRESH" />
                <action android:name="com.taskbar.app.WIDGET_STEP_DONE" />
                <action android:name="com.taskbar.app.WIDGET_ADD_TASK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/track_widget_info" />
        </receiver>

        <!-- 小部件列表 RemoteViewsService -->
        <service
            android:name=".widget.TrackWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

    </application>

</manifest>
