<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 27+ 才支持浅色导航栏（minSdk 26，所以单独放 v27 避免 lint 报旧版本无效属性） -->
    <style name="Theme.TaskBar" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/bg_paper_deep</item>
        <item name="android:navigationBarColor">@color/panel_solid</item>
        <item name="android:windowBackground">@color/bg_paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
