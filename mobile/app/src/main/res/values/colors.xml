<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 任务指南配色 v4.6：暖色浅色（与桌面端 desktop/ui/style.css 的 :root 一一对应）
         改配色时，请同时改：
           1) 本文件
           2) ui/UiFoundation.kt 的 TGColors
           3) desktop/ui/style.css 的 :root 变量
    -->

    <!-- 背景 -->
    <color name="bg_paper">#F5EFE0</color>        <!-- 主背景 米色 -->
    <color name="bg_paper_deep">#EDE3CC</color>   <!-- 深一档米色 -->
    <color name="panel">#FCF7EB</color>           <!-- 面板 -->
    <color name="panel_solid">#FAF5E6</color>     <!-- 面板实色（导航栏/顶栏） -->
    <color name="card">#FFFBEF</color>            <!-- 卡片白米色 -->
    <color name="selected">#F4E6B9</color>        <!-- 选中 -->

    <!-- 文字 -->
    <color name="ink">#3A2E1A</color>             <!-- 主文字 深褐 -->
    <color name="ink_soft">#6B5D3E</color>        <!-- 副文字 -->
    <color name="ink_mute">#9C8B6A</color>        <!-- 三级文字 -->
    <color name="ink_faint">#C2B58E</color>       <!-- 四级/分隔 -->

    <!-- 装饰色 -->
    <color name="gold">#C9A227</color>            <!-- 主金：图标/描边 -->
    <color name="gold_light">#E6C77A</color>      <!-- 浅金：填充底 -->
    <color name="gold_deep">#9A7B1A</color>       <!-- 深金：浅底上的可读金文字 -->
    <color name="orange">#D88A3F</color>          <!-- 暖橘 -->
    <color name="jade">#4A8B6F</color>            <!-- 玉青 完成 -->
    <color name="crimson">#B85638</color>         <!-- 朱砂 紧急/高优先级 -->
    <color name="azure">#4F86B5</color>           <!-- 蓝 追踪/重复 -->
    <color name="violet">#8A6BC9</color>          <!-- 紫 涟漪/目标 -->
</resources>
